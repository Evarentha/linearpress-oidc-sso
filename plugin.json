  "settings": "/admin/sso",
  "styles": [
    { "file": "oidc-sso.css", "scope": "all", "paths": ["/login", "/register", "/sso", "/account/connections", "/admin/sso"] }
  ],
  "scripts": [
    { "file": "oidc-sso.js", "scope": "admin", "paths": ["/admin/sso"] }
  ]
}
