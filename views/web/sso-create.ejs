<!--
  Shows the provider name/icon and the openid tail, previews the proposed
  username (a _openid suffix is appended on collision) and email, and
  submits to /sso/confirm-create; a ghost link returns to /login.
  @since 1.0.0
-->
<section class="auth sso-auth">
  <p class="eyebrow">ACCOUNT LINK</p>
  <h1>创建站点账户</h1>
  <p class="sso-create-note">通过 <b><%= providerIcon ? `${providerIcon} ` : '' %><%= providerName %></b> 登录时，没有找到与该平台账号（openid <code>…<%= subTail %></code>）关联的站点账户。</p>
  <p class="sso-create-note">是否使用平台信息创建新账户？创建后即可通过该平台一键登录。</p>
  <div class="sso-create-fields">
    <label>用户名<input value="<%= username %>" readonly disabled><small>用户名已存在时自动附加 <code>_openid<%= subTail %></code> 后缀；后续可在个人资料中修改邮箱等信息。</small></label>
    <label>邮箱<input type="email" value="<%= email ? email : '(平台未提供邮箱)' %>" readonly disabled></label>
  </div>
  <form method="post" action="/sso/confirm-create" class="sso-create-actions">
    <button class="button" type="submit">创建并登录</button>
    <a href="/login" class="sso-ghost">返回登录页</a>
  </form>
</section>